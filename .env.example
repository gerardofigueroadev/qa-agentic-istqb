# ── Jira ────────────────────────────────────────────────────────────
# Usado por /qa-evidencias para adjuntar archivos al ticket vía API REST
# (el MCP de Atlassian no maneja adjuntos).
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://tuorg.atlassian.net
JIRA_EMAIL=tu@email.com
JIRA_API_TOKEN=

# ── Sentry (opcional) ───────────────────────────────────────────────
# DSN de la app bajo prueba, si tú levantas la app localmente y quieres
# que reporte errores a tu proyecto de Sentry.
SENTRY_DSN=
SENTRY_ENV=qa
